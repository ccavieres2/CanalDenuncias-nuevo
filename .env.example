# Copia este archivo a .env (cp .env.example .env) y ajusta los valores.

# --- PostgreSQL ---
# En Docker, DB_HOST lo fija docker-compose ("db"). Para RDS: el endpoint de la instancia.
DB_USER=canal
DB_PASSWORD=canal_dev_password
DB_SSL=false
# Con DB_SSL=true se verifica el certificado del servidor. En RDS, descarga el bundle de Amazon
# (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem) e indica su ruta:
# DB_SSL_CA_FILE=/app/certs/rds-global-bundle.pem
# DB_SSL_VERIFY=false   # desactiva la verificación: NO usar en producción
# Puerto expuesto en tu PC (para conectarte con DBeaver/pgAdmin). Cámbialo si ya usas el 5432.
DB_EXPOSED_PORT=5432

GLOBAL_DB_NAME=canal_global
TENANT_DB_PREFIX=tenant_

# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Clave para cifrar los secretos del doble factor (2FA) en la base de datos.
# Si se pierde o se cambia, todos los usuarios tendrán que volver a configurar su Authenticator.
# Genera una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=cambia-esto-por-una-clave-aleatoria
# Nombre que aparece en la app de autenticación.
MFA_ISSUER=Canal de Denuncias
# Proxies delante del backend (1 = el proxy de Vite en desarrollo / el balanceador en AWS).
TRUST_PROXY=1

# Dirección pública de la app (enlaces de los correos y verificación de origen contra CSRF).
APP_URL=http://localhost:5173
# Cookie de sesión solo por HTTPS. Por defecto se activa si APP_URL empieza con https (producción).
# COOKIE_SECURE=true

# --- Correo (recuperación de contraseña) ---
# En desarrollo no hace falta nada: docker compose usa Mailpit y los correos se ven en http://localhost:8025.
# Producción con Amazon SES (credenciales SMTP de SES, no las de IAM):
# SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=Canal de Denuncias <no-responder@canal-denuncias.local>
# Lo anterior es solo el respaldo final: el SMTP normalmente se configura en la app
# (consola → «Correo saliente» para toda la plataforma; cada empresa puede configurar el suyo).
# Clave para cifrar las contraseñas SMTP guardadas en la base (si falta, se deriva de MFA_ENCRYPTION_KEY).
# SETTINGS_ENCRYPTION_KEY=
# Permite que las empresas usen servidores SMTP de la red interna (solo instalaciones propias).
# ALLOW_PRIVATE_SMTP=false

# --- Primer global_admin (solo se crea si la tabla está vacía) ---
GLOBAL_ADMIN_EMAIL=admin@canal-denuncias.local
GLOBAL_ADMIN_PASSWORD=Admin12345!
GLOBAL_ADMIN_NAME=Administrador Global

# --- Archivos (logos y evidencias de denuncias) ---
# local = carpeta ./storage del proyecto (desarrollo). s3 = bucket S3 privado (producción).
# Estructura en ambos casos: <empresa>/branding/… y <empresa>/denuncias/<ley>/<código>/…
STORAGE_DRIVER=local
# Producción (STORAGE_DRIVER=s3). En AWS las credenciales vienen del rol IAM; no se ponen aquí.
# S3_BUCKET=canal-denuncias-archivos
# S3_REGION=sa-east-1
# S3_KMS_KEY_ID=            # opcional: cifrado con una clave KMS propia (si no, AES-256 de S3)
# Solo para probar con el S3 local (Adobe S3Mock): docker compose --profile s3 up -d s3
# S3_ENDPOINT=http://s3:9090
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# --- Auditoría ---
# Meses que se mantienen en la base (el actual incluido). Los anteriores se archivan comprimidos en
# <almacenamiento>/plataforma/auditoria/AAAA/AAAA-MM-<fecha>.jsonl.gz y se eliminan de la base.
AUDIT_HOT_MONTHS=12
# Minutos en que no se repite «abrió la denuncia» de la misma persona, con el mismo rol, sobre la misma denuncia.
AUDIT_CASE_VIEW_WINDOW=30
